    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst now = new Date();\n\nreturn items.map(item => {\n  const startedAt = new Date(item.json.started_at);\n  const hoursElapsed = (now - startedAt) / (1000 * 60 * 60);\n  \n  let action = 'skip';\n  if (hoursElapsed >= 7) {\n    action = 'auto_close';\n  } else if (hoursElapsed >= 6 && item.json.reminded === 'no') {\n    action = 'remind';\n  }\n  \n  return {\n    json: {\n      ...item.json,\n      hours_elapsed: Math.round(hoursElapsed * 10) / 10,\n      action: action\n    }\n  };\n});"
      },
